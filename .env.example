# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=keygate
POSTGRES_PASSWORD=keygate_dev_pass
POSTGRES_DB=keygate
POSTGRES_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql+psycopg://keygate:keygate_dev_pass@localhost:5432/keygate
DATABASE_CONNECT_TIMEOUT=3
APP_NAME=GarageMind
APP_ENV=development
DEBUG=false

# --- Dane testowe (scripts/seed.py) ---
# Hasła muszą mieć min. 15 znaków.
# Hasło początkowe konta ADMIN - przy pierwszym logowaniu wymuszona zmiana.
ADMIN_INITIAL_PASSWORD=zmien-mnie-haslo-startowe-admina
# Wspólne hasło użytkowników testowych (Redaktor, Czytelnik).
SEED_USER_PASSWORD=testowe-haslo-uzytkownikow-seed

# --- Canarytokens (see docs/canarytokens.md) ---
# Login of the trap account created by the seed (random password, nobody knows it).
CANARY_TRAP_LOGIN=svc_backup
# "Web bug / URL" token created on https://canarytokens.org (alerts go to the email you
# entered there). Keep your real URL only in your local .env. Empty = no HTTP call, log only.
CANARY_TRAP_URL=

# --- CAPTCHA (Cloudflare Turnstile) ---
# Poniższe klucze to publiczne klucze testowe Cloudflare (widżet i weryfikacja zawsze przechodzą).
# Produkcyjne klucze: dashboard.cloudflare.com -> Turnstile.
CAPTCHA_ENABLED=false
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
